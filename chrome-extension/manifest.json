{
  "manifest_version": 3,
  "name": "Google Photos Cleaner",
  "version": "3.0",
  "description": "Archive/unarchive photos by URL to prepare for bulk deletion.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://photos.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GP Cleaner"
  },
  "background": {
    "service_worker": "background.js"
  }
}
